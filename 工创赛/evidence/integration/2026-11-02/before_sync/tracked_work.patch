+    if (count < 0 || (uint32_t)count >= sizeof(frame)) return;
+    used = (uint32_t)count;
+    for (phase = 0U; phase < 2U; phase++)
+        for (i = 0U; i < 4U; i++)
+        {
+            count = snprintf(frame + used, sizeof(frame) - used, "%lu,%lu,%lu,",
