-static void App_SerialMotionCommand(char *line)
-{
-    char *last = strrchr(line, ',');
-    const char *p;
-    uint32_t seq, tick, crc = 0U, i, digit, now;
-    if ((strncmp(line, "RC1,", 4U) != 0) || (last == NULL) || strlen(last + 1) != 4U)
-    { App_SerialReject(4U); return; }
