-def _human_readable_bytes(bytes: int) -> str:
-    if bytes < 10**3:
-        return f"{bytes} Byte"
-    if bytes < 10**6:
-        return f"{bytes / 10**3:.1f} kB"
-    if bytes < 10**9:
-        return f"{bytes / 10**6:.1f} MB"
-    return f"{bytes / 10**9:.1f} GB"
