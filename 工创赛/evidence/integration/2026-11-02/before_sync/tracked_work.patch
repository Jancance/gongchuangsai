-                    f"{self._layout.rectangle.width - 2 * self._layout.border_width} "
-                    f"{self._layout.rectangle.height - 2 * self._layout.border_width} re\n"
-                    f"{border_width_string}"
-                    f"{self._layout.border_color.as_operator(stroke=True)}\n"
