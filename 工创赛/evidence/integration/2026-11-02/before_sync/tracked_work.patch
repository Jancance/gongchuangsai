-class CryptRC4(CryptBase):
-    def __init__(self, key: bytes) -> None:
-        self.key = key
-
-    def encrypt(self, data: bytes) -> bytes:
-        return ARC4.ARC4Cipher(self.key).encrypt(data)
-
