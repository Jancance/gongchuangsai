-    retval: list[Any] = []
-    if len(containers):
-        for container in containers:
-            for item in container.getElementsByTagNameNS(RDF_NAMESPACE, "li"):
-                value = self._get_text(item)
-                value = converter(value)
-                retval.append(value)
-        return retval
-    return None
