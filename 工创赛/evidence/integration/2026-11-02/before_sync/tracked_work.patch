+    crc = App_SerialCrc(frame, used);
+    count = snprintf(frame+used, sizeof(frame)-used, "%04X\r\n", crc);
+    if (count < 0 || (uint32_t)count >= sizeof(frame)-used) return;
+    if (App_DebugSendString(frame) == 1U) { cursor++; last = now; }
+#endif
