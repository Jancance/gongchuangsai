-    def _remove_objects_from_page__clean_forms(
-            self,
-            elt: DictionaryObject,
-            stack: list[DictionaryObject],
-            jump_operators: list[bytes],
-            to_delete: ObjectDeletionFlag,
-            text_filters: Optional[dict[str, Any]] = None,
