+        uint32_t slot=g_combined_test.completed;
+        g_perimeter_records[slot].captured=1U;g_perimeter_records[slot].tick_ms=now;
+        g_perimeter_records[slot].pose=s_odometry.status;
+        s_perimeter_completed_seen=slot;
+    }
+    taskEXIT_CRITICAL();
