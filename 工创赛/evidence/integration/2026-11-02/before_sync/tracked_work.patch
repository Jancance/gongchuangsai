-    def _remove_objects_from_page__clean(
-            self,
-            content: ContentStream,
-            images: list[str],
-            forms: list[str],
-            jump_operators: list[bytes],
-            to_delete: ObjectDeletionFlag,
-            text_filters: Optional[dict[str, Any]] = None,
