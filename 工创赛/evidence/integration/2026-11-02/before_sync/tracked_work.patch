-def _derive_character_map_from_font_file(
-    font_file: StreamObject,
-    font_data: bytes,
-    font_file_processor: Callable[[bytes, dict[Any, Any], list[int]], tuple[dict[Any, Any], list[int]]],
-    map_dict: dict[Any, Any],
-    int_entry: list[int],
