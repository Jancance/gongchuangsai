-WHITESPACES = (b"\x00", b"\t", b"\n", b"\f", b"\r", b" ")
-WHITESPACES_AS_BYTES = b"".join(WHITESPACES)
-WHITESPACES_AS_REGEXP = b"[" + WHITESPACES_AS_BYTES + b"]"
