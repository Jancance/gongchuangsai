-    @classmethod
-    def from_font_resource(
-        cls,
-        pdf_font_dict: DictionaryObject,
-    ) -> Font:
-        from pypdf._codecs.core_font_metrics import CORE_FONT_METRICS  # noqa: PLC0415
-
-        # Can collect base_font, name and encoding directly from font resource.
