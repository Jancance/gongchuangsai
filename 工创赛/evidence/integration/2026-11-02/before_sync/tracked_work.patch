-            i = ind.idnum
-        else:
-            i = len(pdf_dest._objects) + 1
-        if ind is not None:
-            if id(ind.pdf) not in pdf_dest._id_translated:
-                pdf_dest._id_translated[id(ind.pdf)] = {}
-                pdf_dest._id_translated[id(ind.pdf)]["PreventGC"] = ind.pdf
-            if (
