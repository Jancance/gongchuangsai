-    def _get_single_value(
-        self,
-        namespace: str,
-        name: str,
-        converter: Callable[[str], Any] = _identity,
-    ) -> Optional[Any]:
-        cached = self.cache.get(namespace, {}).get(name)
-        if cached:
-            return cached
-        value = None
-        for element in self.get_element("", namespace, name):
