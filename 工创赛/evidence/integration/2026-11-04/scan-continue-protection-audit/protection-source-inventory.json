        "text": "static void VehicleMission_Fail(uint32_t cause)"
      },
      {
        "line": 274,
        "text": "if(VEHICLE_CHAIN_STAGE12 && g_vehicle_stage==1U){if(!VehicleMission_Load(2U))VehicleMission_Fail(7U);return;}"
      },
      {
        "line": 278,
        "text": "if(!VehicleMission_Load(g_vehicle_stage+1U))VehicleMission_Fail(7U);"
      },
      {
        "line": 314,
        "text": "VehicleMission_Fail(2U);g_vehicle_state=7U;return;"
      },
      {
        "line": 334,
        "text": "if(!StartupAxes_Holding() && !StartupAxes_Begin()){VehicleMission_Fail(3U);return;}g_vehicle_state=1U;"
      },
      {
        "line": 338,
        "text": "{VehicleMission_Fail(4U);return;}"
      },
      {
        "line": 341,
        "text": "{VehicleMission_Fail(5U);return;}"
      },
      {
        "line": 345,
        "text": "if(g_vehicle_queue_wait_ms>=VEHICLE_QUEUE_ADMISSION_TIMEOUT_MS){g_vehicle_queue_state=3U;VehicleMission_Fail(7U);return;}"
      },
      {
        "line": 347,
        "text": "if(g_vehicle_queue_last_mask&~(32U|256U)){g_vehicle_queue_state=3U;VehicleMission_Fail(7U);return;}"
      },
      {
        "line": 359,
        "text": "if(!VehicleMission_Load(VEHICLE_RUN_ALL?1U:VEHICLE_TEST_STAGE)){VehicleMission_Fail(7U);return;}"
      },
      {
        "line": 363,
        "text": "g_vehicle_scan_search_state<=2U && now-s_vehicle_search_begin>=VEHICLE_SCAN_SEARCH_TOTAL_MS){VehicleMission_Fail(18U);return;}"
      },
      {
        "line": 365,
        "text": "if(g_combined_test.state>=4U){VehicleMission_Fail(8U);return;}"
      },
      {
        "line": 367,
        "text": "if(g_vehicle_stage==1U && !VehicleMission_CaptureHandoff()){VehicleMission_Fail(10U);return;}"
      },
      {
        "line": 370,
        "text": "if(!g_vehicle_scan_search_state){s_vehicle_search_begin=now;if(!VehicleMission_Search(1U))VehicleMission_Fail(17U);}"
      },
      {
        "line": 371,
        "text": "else if(g_vehicle_scan_search_state==1U){if(!VehicleMission_Search(2U))VehicleMission_Fail(17U);}"
      },
      {
        "line": 372,
        "text": "else {g_vehicle_scan_search_state=3U;VehicleMission_Fail(16U);}"
      },
      {
        "line": 377,
        "text": "if(g_scan_display_result!=SCREEN_OK){VehicleMission_Fail(9U);return;}"
      },
      {
        "line": 382,
        "text": "{VehicleMission_Fail(10U);return;}"
      },
      {
        "line": 386,
        "text": "if(!VehicleMission_CaptureHandoff()){VehicleMission_Fail(10U);return;}"
      },
      {
        "line": 390,
        "text": "{VehicleMission_Fail(20U);return;}"
      },
      {
        "line": 394,
        "text": "if(!queued){VehicleMission_Fail(7U);return;}"
      },
      {
        "line": 401,
        "text": "if(!VehicleArm_BeginSourcePreparation()){VehicleMission_Fail(13U);return;}"
      },
      {
        "line": 411,
        "text": "if(!VehicleMission_ArmProfileReady(g_vehicle_stage)){VehicleMission_Fail(15U);return;}"
      },
      {
        "line": 417,
        "text": "if(g_vehicle_arm_state==3U || g_source_prepare_state==4U){VehicleMission_Fail(12U);return;}"
      },
      {
        "line": 422,
        "text": "if(g_vehicle_arm_row>=32U || g_vehicle_item>=3U){VehicleMission_Fail(11U);return;}"
      },
      {
        "line": 433,
        "text": "if(g_vehicle_arm_state==3U){VehicleMission_Fail(12U);return;}"
      },
      {
        "line": 438,
        "text": "if(!VehicleArm_Begin(&resolved,g_vehicle_item))VehicleMission_Fail(13U);"
      }
    ]
