--- base/USER\sync_batch.h
+++ sync/USER\sync_batch.h
@@ -0,0 +1,49 @@
+#ifndef SYNC_BATCH_H
+#define SYNC_BATCH_H
+#include <stdint.h>
+/* 同步命令只允许完整一代：四轮先缓存，再单次触发；无效后不重试。 */
+#define SYNC_BATCH_STAGE_MS 100U
+#define SYNC_BATCH_REPLY_MS 50U
+#define SYNC_BATCH_STAGING 1U
+#define SYNC_BATCH_CLAIMED 2U
+#define SYNC_BATCH_COMMITTED 3U
+#define SYNC_BATCH_INVALID 4U
+typedef struct {
+    uint32_t session,generation,mask,phase,begin_ms,trigger_ms;
+} SyncBatch;
+static __inline void SyncBatch_Abort(SyncBatch *b) {
+    b->mask=0U;b->phase=SYNC_BATCH_INVALID;
+}
+static __inline void SyncBatch_Begin(SyncBatch *b,uint32_t session,uint32_t now) {
+    b->generation++;if(!b->generation)b->generation++;
+    b->session=session;b->mask=0U;b->phase=SYNC_BATCH_STAGING;
+    b->begin_ms=now;b->trigger_ms=0U;
+}
+static __inline uint32_t SyncBatch_Ack(SyncBatch *b,uint32_t session,
+    uint32_t generation,uint32_t index,uint32_t result,uint32_t now) {
+    if(b->phase!=SYNC_BATCH_STAGING || b->session!=session ||
+       b->generation!=generation || index>=4U || result!=1U ||
+       b->mask!=((1UL<<index)-1U) || (uint32_t)(now-b->begin_ms)>=SYNC_BATCH_STAGE_MS) {
+        SyncBatch_Abort(b);return 0U;
+    }
+    b->mask|=1UL<<index;return 1U;
+}
+static __inline uint32_t SyncBatch_Ready(const SyncBatch *b,uint32_t session,
+    uint32_t generation,uint32_t now) {
+    return b->phase==SYNC_BATCH_STAGING && b->session==session &&
+        b->generation==generation && b->mask==15U &&
+        (uint32_t)(now-b->begin_ms)<SYNC_BATCH_STAGE_MS;
+}
+static __inline uint32_t SyncBatch_Claim(SyncBatch *b,uint32_t session,
+    uint32_t generation,uint32_t now) {
+    if(!SyncBatch_Ready(b,session,generation,now))return 0U;
+    b->phase=SYNC_BATCH_CLAIMED;b->trigger_ms=now;return 1U;
+}
+static __inline uint32_t SyncBatch_Finish(SyncBatch *b,uint32_t result,uint32_t now) {
+    if(b->phase!=SYNC_BATCH_CLAIMED || result!=1U ||
+       (uint32_t)(now-b->trigger_ms)>=SYNC_BATCH_REPLY_MS) {
+        SyncBatch_Abort(b);return 0U;
+    }
+    b->phase=SYNC_BATCH_COMMITTED;return 1U;
+}
+#endif
