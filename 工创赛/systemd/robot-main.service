[Unit]
Description=Smart Carrier autonomous runtime
After=robot-health.service
Requires=robot-health.service

[Service]
Type=simple
User=robot
Group=robot
SupplementaryGroups=dialout video
WorkingDirectory=/opt/smart-carrier
ExecStartPre=/opt/smart-carrier/.venv/bin/robot-health --config /opt/smart-carrier/config
ExecStart=/opt/smart-carrier/.venv/bin/robot-main --config /opt/smart-carrier/config
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/smart-carrier /var/log/smart-carrier
PrivateTmp=true

[Install]
WantedBy=multi-user.target

